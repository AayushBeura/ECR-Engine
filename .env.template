## ── Backend (Railway / Render) ────────────────────────────────────────────
SUPABASE_URL="your-project-url"
SUPABASE_KEY="your-anon-or-service-role-key"
ENCRYPTION_KEY="your-32-byte-base64-key"   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOCK_DB=True                                # Set False to enable real Supabase persistence

# comma-separated, or '*' to allow all origins (fine for PoC)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

## ── Frontend (Vercel) ─────────────────────────────────────────────────────
# Set this in Vercel dashboard → Settings → Environment Variables
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app